<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
  targetNamespace="https://www.ddeworld.org/resource/standards/dde/ds01/metadata/1.0"
  xmlns:metadata="https://www.ddeworld.org/resource/standards/dde/ds01/metadata/1.0"
  xmlns:xlink="http://www.w3.org/1999/xlink">

  <xs:element name="MD_Metadata">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="metadataIdentifier" type="metadata:MD_Identifier"/>
        <xs:element name="metadataStandardName"
          default="DDE S01-2023: Geosciences Information Metadata" maxOccurs="1">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <!-- Ensure the length is greater than zero -->
              <xs:minLength value="12"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="metadataResponsibleParty" type="metadata:CI_Responsibility"
          maxOccurs="unbounded"/>
        <xs:element name="metadataDate" type="metadata:CI_Date" minOccurs="1" maxOccurs="unbounded"/>
        <xs:element name="identificationInfo" type="metadata:MD_Identification" minOccurs="1"
          maxOccurs="1"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="MD_Identifier">
    <xs:sequence>
      <xs:element name="authority" type="metadata:CI_Responsibility" minOccurs="0" maxOccurs="1"/>
      <xs:element name="code" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <!-- Ensure the length is greater than zero -->
            <xs:minLength value="5"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="codeSpace" type="metadata:CharacterString_Type" minOccurs="0" maxOccurs="1"/>
      <xs:element name="version" type="metadata:CharacterString_Type" minOccurs="0" maxOccurs="1"/>
      <xs:element name="description" type="metadata:CharacterString_Type" minOccurs="0"
        maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MD_Identification">
    <xs:sequence>
      <xs:element name="resourceIdentifier" type="metadata:MD_Identifier"/>
      <xs:element name="title" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <!-- Ensure the length is greater than 20 characters -->
            <xs:minLength value="20"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="alternateTitle" type="metadata:CharacterString_Type" minOccurs="0"
        maxOccurs="unbounded"/>
      <xs:element name="resourceDate" type="metadata:CI_Date" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="abstract" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <!-- Ensure the length is greater than 250 characters -->
            <xs:minLength value="250"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="keyword" type="metadata:Anchor_Type" minOccurs="3" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>using Anchor_Type allows including URIs for keywords in the href
            attribute. This will enable interoperability and linked data</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="topicCategory" type="metadata:TopicCategoryCode" minOccurs="1"
        maxOccurs="unbounded"/>
      <xs:element name="resourceType" type="metadata:ResourceTypeCode" maxOccurs="unbounded"/>
      <xs:element name="additionalDocumentation" type="metadata:CharacterString_Type" minOccurs="0"
        maxOccurs="1"/>
      <xs:element name="resourceResponsibleParty" type="metadata:CI_Responsibility" minOccurs="0"
        maxOccurs="unbounded"/>
      <xs:element name="browseGraphic" type="metadata:CI_OnlineResource" minOccurs="0"
        maxOccurs="unbounded"/>
      <xs:element name="language" minOccurs="1" maxOccurs="unbounded" default="en">
        <xs:annotation>
          <xs:documentation> LanguageCode is implemented as xs:string; full language code list is
            not included in the schema. See
            https://www.loc.gov/standards/iso639-2/php/code_list.php. Use 639-1 two character codes
            or 639-2 three character codes.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <!-- Ensure the length is 2 or 3 characters -->
            <xs:minLength value="2"/>
            <xs:maxLength value="3"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="characterEncoding" type="metadata:CharacterSetCode" minOccurs="1"
        maxOccurs="unbounded" default="UTF-8">
        <xs:annotation>
          <xs:documentation>full IANA character encoding list is not included in schema, implemented
            with xs:string. Use IANA Character Set register:
            http://www.iana.org/assignments/character-sets. These are the official names for
            character sets that may be used on the Internet and may be referred to in Internet
            documentation. These names are expressed in ANSI_X3.4-1968 which is commonly called
            US-ASCII or simply ASCII. Note that the codelist implemenation allows other codes with
            the prefix 'other:'</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="restriction" type="metadata:MD_Constraints" minOccurs="1"
        maxOccurs="unbounded"/>
      <xs:element name="edition" type="metadata:CharacterString_Type" minOccurs="0" maxOccurs="1"/>
      <xs:element name="dataQuality" type="metadata:Anchor_Type" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>Use of the anchor type allows an href link to a more complete data
            quality report that might conform to ISO19157 or other scheme for reporting data quality
            assesment and testing in detail.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="lineage" type="metadata:Anchor_Type" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>Use of the anchor type allows an href link to a more complete lineage
            statment using the prov vocabulary or some profile of that, or the detailed linage that
            can be reported with ISO19115-3 mrl namespace. </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="source" type="metadata:Anchor_Type" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Use of the anchor type allows an href link to DOI or other identifiers
            for sources used to create the described resource.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="acquisitionType" type="metadata:AcquisitionCode" minOccurs="0"
        maxOccurs="unbounded"/>
      <xs:element name="geoTime" type="metadata:CharacterString_Type" minOccurs="1"
        maxOccurs="unbounded"/>
      <xs:element name="geographicExtent" type="metadata:EX_GeographicExtent" minOccurs="0"
        maxOccurs="unbounded"/>
      <xs:element name="temporalExtent" type="metadata:EX_TemporalExtent" minOccurs="0"
        maxOccurs="1"/>
      <xs:element name="associatedResource" type="metadata:MD_AssociatedResource" minOccurs="0"
        maxOccurs="unbounded"/>
      <xs:element name="metadataReference" type="metadata:CI_OnlineResource" minOccurs="0"
        maxOccurs="unbounded"/>
      <xs:element name="distributionInfo" type="metadata:MD_Distribution" maxOccurs="unbounded"/>
      <xs:element name="serviceIdentificationInfo" type="metadata:SV_ServiceIdentification"
        minOccurs="0" maxOccurs="1"/>
      <xs:element name="imageryInfo" type="metadata:MD_Imagery" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MD_AssociatedResource">
    <xs:sequence>
      <xs:element name="resourceCitation" type="metadata:CI_OnlineResource"/>
      <xs:element name="relation" type="metadata:CharacterString_Type" minOccurs="0"
        maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="EX_TemporalExtent">
    <xs:sequence>
      <xs:element name="beginName" type="metadata:CharacterString_Type"/>
      <xs:element name="beginIdentifier" type="metadata:MD_Identifier" minOccurs="0" maxOccurs="1"/>
      <xs:element name="endName" type="metadata:CharacterString_Type" minOccurs="0" maxOccurs="1"/>
      <xs:element name="endIdentifier" type="metadata:MD_Identifier" minOccurs="0" maxOccurs="1"/>
      <xs:element name="beginDate" type="metadata:DateTime" minOccurs="0" maxOccurs="1"/>
      <xs:element name="endDate" type="metadata:DateTime" minOccurs="0" maxOccurs="1"/>
      <xs:element name="beginCoordinate" type="xs:decimal" minOccurs="0" maxOccurs="1"/>
      <xs:element name="endCoordinate" type="xs:decimal" minOccurs="0" maxOccurs="1"/>
      <xs:element name="coordinateUnits" type="metadata:TemporalUnitsEnum" minOccurs="0"
        maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="EX_GeographicExtent">
    <xs:sequence>
      <xs:element name="verbatimCoordinateLocation" type="metadata:CharacterString_Type"
        maxOccurs="1"/>
      <xs:element name="geographicIdentifier" type="metadata:MD_Identifier" minOccurs="0"
        maxOccurs="unbounded"/>
      <xs:element name="elevation" type="metadata:CharacterString_Type" minOccurs="0" maxOccurs="1"/>
      <xs:element name="westBoundLongitude" type="xs:decimal" minOccurs="0" maxOccurs="1"/>
      <xs:element name="eastBoundLongitude" type="xs:decimal" minOccurs="0" maxOccurs="1"/>
      <xs:element name="southBoundLatitude" type="xs:decimal" minOccurs="0" maxOccurs="1"/>
      <xs:element name="northBoundLatitude" type="xs:decimal" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MD_Constraints">
    <xs:sequence>
      <xs:element name="restrictionText" type="metadata:Anchor_Type" minOccurs="0"
        maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>restriction text has type anchor type to allow href link (URI) to formal
            statement of restriction, without having to copy that into the metadata
            document.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="restrictionCode" type="metadata:RestrictionCode" minOccurs="1"
        maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SV_ServiceIdentification">
    <xs:sequence>
      <xs:element name="serviceType" type="metadata:ServiceTypeCode" maxOccurs="1"/>
      <xs:element name="containOperations" type="metadata:CharacterString_Type" minOccurs="0"
        maxOccurs="unbounded"/>
      <xs:element name="accessProperties" type="metadata:CharacterString_Type" minOccurs="0"
        maxOccurs="1"/>
      <xs:element name="operatedDataset" type="metadata:MD_Identifier" minOccurs="0"
        maxOccurs="unbounded"/>
      <!-- see https://www.energistics.org/sites/default/files/2023-03/EIP_v1.1.pdf section 4.6.2 -->
      <xs:element name="endpointDescription" type="metadata:CI_OnlineResource" minOccurs="0"
        maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CI_OnlineResource">
    <xs:sequence>
      <xs:element name="title" type="metadata:CharacterString_Type" minOccurs="0" maxOccurs="1"/>
      <xs:element name="applicationProfile" type="metadata:Anchor_Type" minOccurs="0"
        maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>the href on the applicationProfile anchorType should provide a URI for a
            detailed profile definition, typically extending the base mime types sepcified in the
            distributionFormat element. See https://www.w3.org/TR/dx-prof/</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="description" type="metadata:CharacterString_Type" minOccurs="0"
        maxOccurs="1"/>
      <xs:element name="linkage" type="metadata:CharacterString_Type"/>
      <xs:element name="function" type="metadata:FunctionCode" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MD_Imagery">
    <xs:sequence>
      <xs:element name="sensor" type="metadata:Anchor_Type" minOccurs="0"
        maxOccurs="unbounded"/>
      <xs:element name="platform" type="metadata:Anchor_Type" minOccurs="0" maxOccurs="1"/>
      <xs:element name="equipment" type="metadata:Anchor_Type" minOccurs="0" maxOccurs="1"/>
      <xs:element name="signalGenerator" type="metadata:Anchor_Type" minOccurs="0"
        maxOccurs="1"/>
      <xs:element name="wavelength" type="metadata:CharacterString_Type" minOccurs="0" maxOccurs="1"/>
      <xs:element name="processingLevel" type="metadata:ProcessingLevelCode" minOccurs="0"
        maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MD_Distribution">
    <xs:sequence>
      <xs:element name="distributionFormat" type="metadata:Anchor_Type" minOccurs="0"
        maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>format has anchor type to allow href to URI that will identify a format
            using a globally unique identifier, for better interoperability. Generally formats will
            be identified with MIME types. The applicationProfile on the CI_OnlineResource should be
            used to identify specific profiles for a particular download.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="onlineResource" type="metadata:CI_OnlineResource" minOccurs="1"
        maxOccurs="unbounded"/>
      <xs:element name="distributionResponsibleParty" type="metadata:CI_Responsibility"
        minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="spatialRepresentationInfo" type="metadata:MD_SpatialRepresentation"
        minOccurs="0" maxOccurs="1"/>

    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MD_SpatialRepresentation">
    <xs:sequence>
      <xs:element name="spatialRepresentationType" type="metadata:SpatialRepresentationTypeCode"/>
      <xs:element name="spatialResolution" type="metadata:CharacterString_Type" minOccurs="0"
        maxOccurs="unbounded"/>
      <xs:element name="referenceSystemType" minOccurs="0" type="metadata:ReferenceSystemTypeCode"/>
      <xs:element name="referenceSystemIdentifier" type="metadata:MD_Identifier"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CI_Responsibility">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="role" type="metadata:RoleTypeCode" minOccurs="1" maxOccurs="unbounded"/>
      <xs:element name="identifier" type="metadata:MD_Identifier" minOccurs="0"
        maxOccurs="unbounded"/>
      <xs:element name="country" type="metadata:CountryCode" minOccurs="0" maxOccurs="1"/>
      <xs:element name="electronicMailAddress" type="metadata:CharacterString_Type" minOccurs="0"
        maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Anchor_Type">
    <xs:annotation>
      <xs:documentation>This type implements values that are a string that is a label associated
        with a URI that links to some web resource. The metadata:href attribute is a uri that will
        access a resource with more complete information about the element value.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="href" type="xs:anyURI" use="optional"/>
        <xs:attribute name="nilReason" type="metadata:NilReasonType" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="CharacterString_Type">
    <xs:annotation>
      <xs:documentation>This type implements values that are a string, or an empty element with a
        metadata:nilReason attribute asserting the reason for the missing value. Use to implement
        nilable properties that have a string value.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="nilReason" type="metadata:NilReasonType" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="CI_Date">
    <xs:sequence>
      <xs:element name="date" type="metadata:DateTime"/>
      <xs:element name="dateType" type="metadata:DateTypeCode"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="DateTime">
    <xs:annotation>
      <xs:documentation>DateTime element for DDE allows YYYY, YYYY-MM, YYYY-MM-DD, and
        YYYY-MM-DDThh:mm:ss </xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="xs:date xs:dateTime xs:gYear xs:gYearMonth"/>
  </xs:simpleType>

  <!-- *********************************************************************** -->
  <!-- ***********************codelists ********************************** -->

  <xs:simpleType name="AcquisitionCode">
    <xs:union>
      <xs:simpleType>
        <xs:restriction base="xs:token">
          <xs:enumeration value="geologicalMapping"/>
          <xs:enumeration value="survey"/>
          <xs:enumeration value="observation"/>
          <xs:enumeration value="directObservation"/>
          <xs:enumeration value="indirectObservation"/>
          <xs:enumeration value="outcropObservation"/>
          <xs:enumeration value="remoteSensing"/>
          <xs:enumeration value="drillBorehole"/>
          <xs:enumeration value="boreholeCuttingsObservation"/>
          <xs:enumeration value="boreholeGeophysicalLogMeasurements"/>
          <xs:enumeration value="drillCoreObservation"/>
          <xs:enumeration value="laboratoryInstrumentation"/>
          <xs:enumeration value="dataIntegrationSynthesis"/>
          <xs:enumeration value="dataFromSinglePublishedDescription"/>
          <xs:enumeration value="synthesisFromMultipleSources"/>
          <xs:enumeration value="synthesisFromMultipleOutcropObservations"/>
          <xs:enumeration value="synthesisFromMultiplePublishedDescriptions"/>
          <xs:enumeration value="digitalConversionFromPublishedSource"/>
          <xs:enumeration value="digitalSimulation"/>
          <xs:enumeration value="dataAndMapCompilation"/>
          <xs:enumeration value="webResource"/>
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType>
        <xs:annotation>
          <xs:documentation>other acquisition type, prefix 'other:' followed by a string of two or
            more characters with no included spaces. Implication is that none of the other
            acquisition codes apply</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:pattern value="other:\w{2,}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>

  <xs:simpleType name="CharacterSetCode">
    <xs:annotation>
      <xs:documentation>Codes from the IANA register
        (https://www.iana.org/assignments/character-sets/character-sets.xhtml) that are most
        commonly used, according to the text for the register, and information from wikipedia
        (https://en.wikipedia.org/wiki/Popularity_of_text_encodings). The 'other: construct allows
        other character-set names to be included in the metadata, but these should always be a name
        from the IANA register</xs:documentation>
    </xs:annotation>
    <xs:union>
      <xs:simpleType>
        <xs:restriction base="xs:token">
          <xs:enumeration value="US-ASCII">
            <xs:annotation>
              <xs:documentation> Name: US-ASCII. Source: ANSI X3.4-1986. Reference: [RFC2046].
                Aliases: iso-ir-6, ANSI_X3.4-1968, ANSI_X3.4-1986, ISO_646.irv:1991, ISO646-US,
                US-ASCII,us, IBM367, cp367, csASCII</xs:documentation>
            </xs:annotation>
          </xs:enumeration>
          <xs:enumeration value="ISO-8859-1">
            <xs:annotation>
              <xs:documentation> Name: ISO_8859-1:1987. Source: [ISO-IR: International Register of
                Escape Sequences] Note: The current registration authority is IPSJ/ITSCJ, Japan..
                Reference: [RFC1345][Keld_Simonsen]. Aliases: iso-ir-100,ISO_8859-1, ISO-8859-1,
                latin1,l1, IBM819, CP819, csISOLatin1</xs:documentation>
            </xs:annotation>
          </xs:enumeration>
          <xs:enumeration value="Shift_JIS">
            <xs:annotation>
              <xs:documentation> Name: Shift_JIS. Source: This charset is an extension of
                csHalfWidthKatakana by adding graphic characters in JIS X 0208. The CCS's are JIS
                X0201:1997 and JIS X0208:1997. The complete definition is shown in Appendix 1 of JIS
                X0208:1997. This charset can be used for the top-level media type "text"..
                Reference: . Aliases: MS_Kanji,csShiftJIS</xs:documentation>
            </xs:annotation>
          </xs:enumeration>
          <xs:enumeration value="EUC-JP">
            <xs:annotation>
              <xs:documentation> Name: Extended_UNIX_Code_Packed_Format_for_Japanese. Source:
                Standardized by OSF, UNIX International, and UNIX Systems Laboratories Pacific. Uses
                ISO 2022 rules to select code set 0: US-ASCII (a single 7-bit byte set) code set 1:
                JIS X0208-1990 (a double 8-bit byte set) restricted to A0-FF in both bytes code set
                2: Half Width Katakana (a single 7-bit byte set) requiring SS2 as the character
                prefix code set 3: JIS X0212-1990 (a double 7-bit byte set) restricted to A0-FF in
                both bytes requiring SS3 as the character prefix. Reference: . Aliases:
                csEUCPkdFmtJapanese,EUC-JP</xs:documentation>
            </xs:annotation>
          </xs:enumeration>
          <xs:enumeration value="EUC-KR">
            <xs:annotation>
              <xs:documentation> Name: EUC-KR. Source: [RFC1557] (see also KS_C_5861-1992).
                Reference: [RFC1557][Woohyong_Choi]. Aliases: csEUCKR</xs:documentation>
            </xs:annotation>
          </xs:enumeration>
          <xs:enumeration value="UTF-8">
            <xs:annotation>
              <xs:documentation> Name: UTF-8. Source: [RFC3629]. Reference: [RFC3629]. Aliases:
                csUTF8</xs:documentation>
            </xs:annotation>
          </xs:enumeration>
          <xs:enumeration value="GB18030">
            <xs:annotation>
              <xs:documentation> Name: GB18030. Source: Chinese IT Standardization Technical
                Committee. Please see: [https://www.iana.org/assignments/charset-reg/GB18030].
                Reference: . Aliases: csGB18030</xs:documentation>
            </xs:annotation>
          </xs:enumeration>
          <xs:enumeration value="Big5">
            <xs:annotation>
              <xs:documentation> Name: Big5. Source: Chinese for Taiwan Multi-byte set. PCL Symbol
                Set Id: 18T. Reference: . Aliases: csBig5</xs:documentation>
            </xs:annotation>
          </xs:enumeration>
          <xs:enumeration value="windows-1251">
            <xs:annotation>
              <xs:documentation> Name: windows-1251. Source: Microsoft
                [https://www.iana.org/assignments/charset-reg/windows-1251] [Katya_Lazhintseva].
                Reference: . Aliases: cswindows1251</xs:documentation>
            </xs:annotation>
          </xs:enumeration>
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType>
        <xs:annotation>
          <xs:documentation>other character set code from IANA register, prefix 'other:' followed by
            a string of two or more characters with no included spaces. Implication is that none of
            the characater codes in the codelist here apply </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:pattern value="other:\w{2,}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>

  <xs:simpleType name="CountryCode">
    <xs:annotation>
      <xs:documentation>Extracted from
        https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements. The
        DDEUtilities.xsd file contains a lookup table to map country names (with some permutations
        and three-letter country codes to these 2 letter values.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:length value="2"/>
      <xs:enumeration value="AD"/>
      <xs:enumeration value="AE"/>
      <xs:enumeration value="AF"/>
      <xs:enumeration value="AG"/>
      <xs:enumeration value="AI"/>
      <xs:enumeration value="AL"/>
      <xs:enumeration value="AM"/>
      <xs:enumeration value="AO"/>
      <xs:enumeration value="AQ"/>
      <xs:enumeration value="AR"/>
      <xs:enumeration value="AS"/>
      <xs:enumeration value="AT"/>
      <xs:enumeration value="AU"/>
      <xs:enumeration value="AW"/>
      <xs:enumeration value="AX"/>
      <xs:enumeration value="AZ"/>
      <xs:enumeration value="BA"/>
      <xs:enumeration value="BB"/>
      <xs:enumeration value="BD"/>
      <xs:enumeration value="BE"/>
      <xs:enumeration value="BF"/>
      <xs:enumeration value="BG"/>
      <xs:enumeration value="BH"/>
      <xs:enumeration value="BI"/>
      <xs:enumeration value="BJ"/>
      <xs:enumeration value="BL"/>
      <xs:enumeration value="BM"/>
      <xs:enumeration value="BN"/>
      <xs:enumeration value="BO"/>
      <xs:enumeration value="BQ"/>
      <xs:enumeration value="BR"/>
      <xs:enumeration value="BS"/>
      <xs:enumeration value="BT"/>
      <xs:enumeration value="BV"/>
      <xs:enumeration value="BW"/>
      <xs:enumeration value="BY"/>
      <xs:enumeration value="BZ"/>
      <xs:enumeration value="CA"/>
      <xs:enumeration value="CC"/>
      <xs:enumeration value="CD"/>
      <xs:enumeration value="CF"/>
      <xs:enumeration value="CG"/>
      <xs:enumeration value="CH"/>
      <xs:enumeration value="CI"/>
      <xs:enumeration value="CK"/>
      <xs:enumeration value="CL"/>
      <xs:enumeration value="CM"/>
      <xs:enumeration value="CN"/>
      <xs:enumeration value="CO"/>
      <xs:enumeration value="CR"/>
