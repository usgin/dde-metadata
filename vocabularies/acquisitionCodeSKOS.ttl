  rdf:type owl:AnnotationProperty ;
.
skos:scopeNote
  rdf:type owl:AnnotationProperty ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:ConceptScheme ;
  dc:description "terms to categorize method(s) used to create an information resource, focused on geoscience datasets"@en ;
  dc:title "DDE acquisition method codes"@en ;
  dcterms:issued "2023-11-04" ;
  dcterms:modified "2024-03-12" ;
  skos:prefLabel "DDE acquisition method codes"@en ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#boreholeCuttingsObservation>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader <https://www.ddeworld.org/resource/codelist/acquisitioncode#drillBorehole> ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "05.1 Borehole Cuttings Observation"@en ;
  skos:scopeNote "(CGI) Data based on interpretation of borehole cuttings (http://resource.geosciml.org/classifier/cgi/featureobservationmethod/borehole_cuttings_observation)  "@en ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#boreholeGeophysicalLogMeasurements>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader <https://www.ddeworld.org/resource/codelist/acquisitioncode#drillBorehole> ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "05.2 Borehole Geophysical Log Measurements"@en ;
  skos:scopeNote "(CGI) Data based on interpretation of geophysical measurement obtained by borehole logging tools(http://resource.geosciml.org/classifier/cgi/featureobservationmethod/borehole_geophysical_log_measurements).  "@en ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#dataAndMapCompilation>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "10 Data and Map Compilation"@en ;
  skos:scopeNote "Geoscience data and map compilation from existing data, maps and other resources that are usually scattered and in larger scale and of higher spatial resolution. Or the collation of raw data and their transformation into a format that can be easily manipulated or combined with other data in preparation for further analysis(EiE Glossary, https://inee.org/eie-glossary/data-compilation).  "@en ;
  skos:topConceptOf <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#dataFromSinglePublishedDescription>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader <https://www.ddeworld.org/resource/codelist/acquisitioncode#dataIntegrationSynthesis> ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "07.1 Data From Single Published Description"@en ;
  skos:scopeNote "(CGI) Data are extracted from a published description of the feature (http://resource.geosciml.org/classifier/cgi/featureobservationmethod/data_from_single_published_description)  "@en ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#dataIntegrationSynthesis>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "07 Data Integration Synthesis"@en ;
  skos:scopeNote "Data or resource are the result of synthesis from other data or resources, or as the integration of other data or resources.  "@en ;
  skos:topConceptOf <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#digitaConversionFromPublishedSource>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "08 Digital Conversion From Published Source"@en ;
  skos:scopeNote "(CGI) Feature observation is based on published information, converted to a digital representation for database application (http://resource.geosciml.org/classifier/cgi/featureobservationmethod/digital_conversion_from_published_source).  "@en ;
  skos:topConceptOf <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#digitalSimulation>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "09 Digital Simulation"@en ;
  skos:scopeNote "Data generated by digital analyses and simulations with software rather than physical acquisitions.   "@en ;
  skos:topConceptOf <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#directObservation>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader <https://www.ddeworld.org/resource/codelist/acquisitioncode#observation> ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "03.1 Direct Observation"@en ;
  skos:scopeNote "(CGI) Feature observation is result of direct visual observation by a geologist (http://resource.geosciml.org/classifier/cgi/featureobservationmethod/direct_observation).  Direct observation may include observation using a remote camera (e.g. downhole viewer, submarine camera).  "@en ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#drillBorehole>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "05 Drilling or Borehole"@en ;
  skos:scopeNote "Collection or records of drills and boreholes.   "@en ;
  skos:topConceptOf <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#drillCoreObservation>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader <https://www.ddeworld.org/resource/codelist/acquisitioncode#drillBorehole> ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "05.3 Drill Core Observation"@en ;
  skos:scopeNote "(CGI) Data collected through observation of a single drill core interval(http://resource.geosciml.org/classifier/cgi/featureobservationmethod/drill_core_observation).  "@en ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#geologicalMapping>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "01 Geological Mapping"@en ;
  skos:scopeNote "Data collected and acquisition mostly in the field by profiling and stationary observation, sampling, and following laboratory analysis, etc., typically, regional field geological mapping    "@en ;
  skos:topConceptOf <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#indirectObservation>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader <https://www.ddeworld.org/resource/codelist/acquisitioncode#observation> ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "03.2 Indirect Observation"@en ;
  skos:scopeNote "(CGI) Feature observation based on inference from proxy observation(http://resource.geosciml.org/classifier/cgi/featureobservationmethod/indirect_method )  "@en ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#laboratoryInstrumentation>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "06 Laboratory Instrumentation"@en ;
  skos:scopeNote "Data or resource from rock specimen and chemical element analyses in laboratories.  "@en ;
  skos:topConceptOf <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#observation>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "03 Observation"@en ;
  skos:scopeNote "Data collected by stationary measurement, etc. like ground water monitoring.  "@en ;
  skos:topConceptOf <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#other:>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "12 Other"@en ;
  skos:scopeNote "Data and resources obtained from source other than the above. For other values not included in this codelist, use prefix ‘other:’ with a label token (alphanumeric characters, no spaces) of at least 2 characters to specify the acquisition method.   "@en ;
  skos:topConceptOf <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#other:missing>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "Missing value"@en ;
  skos:scopeNote "Sentinel value to flag that no topic category was provided; need this because ISO19115-3 does not require a topic category."@en ;
  skos:topConceptOf <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#outcropObservation>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader <https://www.ddeworld.org/resource/codelist/acquisitioncode#observation> ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "03.3 Outcrop Observation"@en ;
  skos:scopeNote "(CGI) Data collected in field through direct observation of a single outcrop. Observer defines scope of 'single outcrop' - may be one point location, or averaged over an extended but connected area, e.g. a single polygon on a map (http://resource.geosciml.org/classifier/cgi/featureobservationmethod/outcrop_observation).  "@en ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#remoteSensing>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "04 Remote Sensing"@en ;
  skos:scopeNote "Data collected with satellites, airplane platform on drone, etc., typically aero-photography and radar.  Also, (CGI) Geologic unit or structure characterized based on remotely sensed data (http://resource.geosciml.org/classifier/cgi/featureobservationmethod/remotely_sensed_data )  "@en ;
  skos:topConceptOf <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#survey>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "02 Survey"@en ;
  skos:scopeNote "Data collected with equipment records and following processing with planned profile, or areal/regional data acquisition activity, etc., typically, aeromagnetic survey.   "@en ;
  skos:topConceptOf <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#synthesisFromMultipleSources>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader <https://www.ddeworld.org/resource/codelist/acquisitioncode#dataIntegrationSynthesis> ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "07.2 Synthesis From Multiple Sources"@en ;
  skos:scopeNote "(CGI) Feature observation is based on a synthesis of other observations by some compiler. The compiler may be the same individual that made the source observations (http://resource.geosciml.org/classifier/cgi/featureobservationmethod/synthesis_from_multiple_sources).  "@en ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#synthesisOfMultipleOutcropObservations>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader <https://www.ddeworld.org/resource/codelist/acquisitioncode#dataIntegrationSynthesis> ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "07.3 Synthesis Of Multiple Outcrop Observations"@en ;
  skos:scopeNote "(CGI) Data are the result of synthesis from multiple direct observations, possibly by more than one observer (http://resource.geosciml.org/classifier/cgi/featureobservationmethod/synthesis_of_multiple_outcrop_observations).  "@en ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#synthesisOfMultiplePublishedDescriptions>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader <https://www.ddeworld.org/resource/codelist/acquisitioncode#dataIntegrationSynthesis> ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "07.4 Synthesis Of Multiple Published Descriptions"@en ;
  skos:scopeNote "(CGI) Data are the result of synthesis from multiple published descriptions(http://resource.geosciml.org/classifier/cgi/featureobservationmethod/synthesis_of_multiple_published_descriptions).  "@en ;
.
<https://www.ddeworld.org/resource/codelist/acquisitioncode#webResource>
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
  skos:prefLabel "11 Web Resource"@en ;
  skos:scopeNote "Data and resources obtained from the web.  "@en ;
  skos:topConceptOf <https://www.ddeworld.org/resource/codelist/acquisitioncode> ;
.
<https://www.ddeworld.org/resource/ontology/acquisitioncode>
  rdf:type owl:Ontology ;
  owl:imports <http://www.w3.org/2004/02/skos/core> ;
  owl:versionIRI <https://www.ddeworld.org/resource/ontology/1.0/acquisitioncode> ;
  skos:prefLabel "DDE data acquisition method type codes"@en ;
.
