  skos:prefLabel "8.31.6 Gas hydrate"@en ;
  skos:scopeNote "Study of gas hydrate, gas hydrate geology, gas hydrate exploration, gas hydrate exploitation, etc."@en ;
.
ddetc:GI_ER_groundwater
  rdf:type owl:NamedIndividual ;
