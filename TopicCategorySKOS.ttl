  skos:prefLabel "8.31.2 Groundwater"@en ;
  skos:scopeNote "Study of groundwater resources of the Earth in aquifers, including groundwater exploration, groundwater production, etc."@en ;
.
ddetc:GI_ER_mineralResource
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_ER_earthResource ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.31.1 Mineral resource"@en ;
  skos:scopeNote "Mineral resources of the earth, including mineral geology, mineral exploration, mineral exploitation, etc."@en ;
.
ddetc:GI_ER_oilAndGas
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_ER_earthResource ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.31.3 Oil and gas"@en ;
  skos:scopeNote "Study of oil and gas resources in the Earth, including exploration, exploitation, production, distribution of oil and gas fields, etc."@en ;
.
ddetc:GI_ER_organicMaterial
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_ER_earthResource ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.31.7 Organic material"@en ;
  skos:scopeNote "Study of Earth material composed of organic compounds derived from the remains of dead organisms and their waste products in the environment. (CGI)"@en ;
.
ddetc:GI_ER_shaleGasAndOilShale
  rdf:type owl:NamedIndividual ;
