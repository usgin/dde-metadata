  skos:broader <http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/geoscientificInformation> ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:narrower ddetc:GI_MI_chemicalCompositionAndCrystalStructure ;
