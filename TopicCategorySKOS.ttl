  skos:prefLabel "8.31.4 Shale gas and oil shale"@en ;
  skos:scopeNote "Study of the geology, exploration, production of hydrocarbons from of oil shale or shale gas."@en ;
.
ddetc:GI_GC_Geochronology
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader <http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/geoscientificInformation> ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:narrower ddetc:GI_GC_nonradioIsotopicDating ;
  skos:narrower ddetc:GI_GC_radioIsotopicDating ;
  skos:prefLabel "8.3 Geochronology"@en ;
  skos:scopeNote "The science of determining the age of rocks, fossils, and sediments using signatures inherent in the rocks themselves, usingradioactive isotopes,paleomagnetism, stable isotope ratios or other physical evidence. By combining multiple geochronological (and biostratigraphic) indicators the precision of the recovered age can be improved."@en ;
.
ddetc:GI_GC_nonradioIsotopicDating
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_GC_Geochronology ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.3.2 Non-radio isotopic dating"@en ;
  skos:scopeNote "Geochronology that does not rely on the measurements of radiogenic decay."@en ;
.
ddetc:GI_GC_radioIsotopicDating
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_GC_Geochronology ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.3.1 Radio isotopic dating"@en ;
  skos:scopeNote "Geochronolgy based on the rates of radiogenic decay which is proportional to time."@en ;
.
ddetc:GI_GL_dinosaur
  rdf:type owl:NamedIndividual ;
