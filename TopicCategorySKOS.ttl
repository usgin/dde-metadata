ddetc:GI_DGL_coringAndCoreAnalysis
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_DGL_drillAndGeophysicalLogging ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.22.2 Coring and core analysis"@en ;
  skos:scopeNote "Description of instruments and technology used to acquire continuous subsurface samples along a borehole (core), and techniques for measuring properties of the samples at laboratory"@en ;
.
ddetc:GI_DGL_drillAndGeophysicalLogging
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader <http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/geoscientificInformation> ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:narrower ddetc:GI_DGL_coringAndCoreAnalysis ;
  skos:narrower ddetc:GI_DGL_instrumentsForDrillingAndWellLogging ;
  skos:narrower ddetc:GI_DGL_loggingDataAnalysis ;
  skos:prefLabel "8.22 Drill and geophysical logging"@en ;
  skos:scopeNote "Documentation and collection of data for physical and petrophysical properties of subsurface materials acquired using instruments lowered into boreholes.Geophysical logging is based on physics (electric, nuclear, magnetic, etc.), mathematics and geology as the theoretical basis."@en ;
.
ddetc:GI_DGL_instrumentsForDrillingAndWellLogging
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_DGL_drillAndGeophysicalLogging ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.22.1 Instruments for drilling and well logging"@en ;
  skos:scopeNote "Description of instruments and technology used for drilling boreholes, colleting rock and sediment samples, and collecting subsurface data in boreholes."@en ;
.
ddetc:GI_DGL_loggingDataAnalysis
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_DGL_drillAndGeophysicalLogging ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.22.3 Logging data analysis"@en ;
  skos:scopeNote "Study of techniques for analyzing data collected by borehole logging instruments, and relating the data to physical properties and geologic events used for correlation."@en ;
.
ddetc:GI_ECG_characteristicsOfOreDeposits
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_ECG_economicalGeology ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.35.1 Characteristics of ore deposits"@en ;
  skos:scopeNote "Study and description of systematic information describing the attributes of the mineral deposits."@en ;
.
ddetc:GI_ECG_depositType
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_ECG_economicalGeology ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.35.2 Deposit type"@en ;
  skos:scopeNote "Classifications of recognized mineral deposits that are defined by physical and genetic factors that can be consistently differentiated from those of other classes or deposit types.(Bureau of Mines. Dictionary of mining, mineral, and related terms[M]. American Geological Institute, 1997)"@en ;
.
ddetc:GI_ECG_economicalGeology
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader <http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/geoscientificInformation> ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:narrower ddetc:GI_ECG_characteristicsOfOreDeposits ;
  skos:narrower ddetc:GI_ECG_depositType ;
  skos:narrower ddetc:GI_ECG_metallogeny ;
  skos:narrower ddetc:GI_ECG_oreGenesis ;
  skos:prefLabel "8.35 Economical geology"@en ;
  skos:scopeNote "Study of fuels, metals, and other materials from the Earth that are of interest to industry or the economy in general. It is concerned with the distribution of resources, the costs and benefits of their recovery, and the value and availability of existing materials. (Wikipedia)"@en ;
.
ddetc:GI_ECG_metallogeny
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_ECG_economicalGeology ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.35.4 Metallogeny"@en ;
  skos:scopeNote "Study of the genesis and regional-to-global distribution of metallic mineral deposits, with emphasis on their relationship in space and time to regional petrologic and tectonic features of the Earth's crust. (Gilbert J M, Park Jr C F. The geology of ore deposits[M]. Waveland Press, 2007)"@en ;
.
ddetc:GI_ECG_oreGenesis
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_ECG_economicalGeology ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.35.3 Ore genesis"@en ;
  skos:scopeNote "Study of the origin of economically producable concentrations of a mineral commodity. "@en ;
.
ddetc:GI_EEG_engineeringGeologyGeotechnology
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader <http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/geoscientificInformation> ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:narrower ddetc:GI_EGG_appliedEngineeringGeology ;
  skos:narrower ddetc:GI_EGG_geologicalHazards ;
  skos:narrower ddetc:GI_EGG_intelligentEngineeringGeology ;
  skos:narrower ddetc:GI_EGG_regionalEngineeringGeology ;
  skos:narrower ddetc:GI_EGG_rockMassEngineeringGeology ;
  skos:narrower ddetc:GI_EGG_soilMassEngineeringGeology ;
  skos:prefLabel "8.11 Engineering geology(geotechnology)"@en ;
  skos:scopeNote "Investigation, study and solution of the engineering and environmental problems that arise as the result of the interaction between geology and the activities of humans, and the prediction and development of measures for prevention or remediation of geological hazards."@en ;
.
ddetc:GI_EGG_appliedEngineeringGeology
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_EEG_engineeringGeologyGeotechnology ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.11.4 Applied engineering geology"@en ;
  skos:scopeNote "Collection and evaluation of data useful for the design and engineering of structures. The subject comprises the modes of application of engineering geology, case histories, evaluation of investigations, design and realization of structures as well as their observation during and after construction."@en ;
.
ddetc:GI_EGG_geologicalHazards
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_EEG_engineeringGeologyGeotechnology ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.11.5 Geological hazards"@en ;
  skos:scopeNote "Study and assessment of natural geologic processes or man-made geologic conditions that represent a present-day or future hazard to man's life, health, or property. Six typical geological hazards, i.e., landslides, debris flows, rockfalls, avalanches, earthquakes, and volcanoes."@en ;
.
ddetc:GI_EGG_intelligentEngineeringGeology
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_EEG_engineeringGeologyGeotechnology ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.11.6 Intelligent engineering geology"@en ;
  skos:scopeNote "Studies that combine innovative concepts with the new generation of information technology to intelligently collect geologic information useful for engineering, mine existing engineering geology knowledge, revealspatial-temporal characteristics and the evolution of engineering geological bodies, and predict their future development trends."@en ;
.
ddetc:GI_EGG_regionalEngineeringGeology
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_EEG_engineeringGeologyGeotechnology ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.11.1 Regional engineering geology"@en ;
  skos:scopeNote "Study of the geologic stability of a particular region that might be affected by crustal movements, volcanic activity orfault activity, especially focused on those activities which might trigger earthquakes and consequent regional mass wasting processes such as rock falls, landslides, debris flow, liquefaction, plastic flows of clay, and uneven surface subsidence."@en ;
.
ddetc:GI_EGG_rockMassEngineeringGeology
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_EEG_engineeringGeologyGeotechnology ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.11.3 Rock mass engineering geology"@en ;
  skos:scopeNote "Study of the laws of formation and evolution of rock masses and their engineering behavior through the theories and methods of geomechanics."@en ;
.
ddetc:GI_EGG_soilMassEngineeringGeology
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_EEG_engineeringGeologyGeotechnology ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.11.2 Soil mass engineering geology"@en ;
  skos:scopeNote "Study of engineering properties of soil to solve geological problems related to engineering activities, and propose technical measures for improvement and hazard prevention in the planning, design, construction, use and development of engineering activities."@en ;
.
ddetc:GI_ER_coalAndCoalbedMethane
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader ddetc:GI_ER_earthResource ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.31.5 Coal and coalbed methane"@en ;
  skos:scopeNote "Study of coal geology and coalbed methane geology, coal and coalbed methane exploration, coal and coalbed methane production and products, etc."@en ;
.
ddetc:GI_ER_earthResource
  rdf:type owl:NamedIndividual ;
  rdf:type skos:Concept ;
  skos:broader <http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/geoscientificInformation> ;
  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:narrower ddetc:GI_ER_coalAndCoalbedMethane ;
  skos:narrower ddetc:GI_ER_gasHydrate ;
  skos:narrower ddetc:GI_ER_groundwater ;
