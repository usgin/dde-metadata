  skos:narrower ddetc:GI_ER_organicMaterial ;
  skos:narrower ddetc:GI_ER_shaleGasAndOilShale ;
  skos:prefLabel "8.31 Earth resource"@en ;
  skos:scopeNote "Study of the occurrence of renewable resources and non-renewable resources that are found in the Earth. Non-renewable resources are the naturally resources that cannot be readily replaced by natural means such as oil and gas, minerals and metal ores, ground water, etc."@en ;
.
ddetc:GI_ER_gasHydrate
  rdf:type owl:NamedIndividual ;
