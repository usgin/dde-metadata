  skos:inScheme <https://www.ddeworld.org/resource/codelist/topicCategory> ;
  skos:prefLabel "8.36.3 Geo-education"@en ;
  skos:scopeNote "Resources related to in-school and out-of-school learning. In school, geo-education takes place across many subjects in the traditional curriculum. Outside of school, geo-education takes place through guided experience in both the human and natural worlds."@en ;
.
